# ==============================================================================
# SURAKSHA AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the platform:
# cp .env.example .env

# ----------------- APPLICATION SETTINGS -----------------
PROJECT_NAME="SURAKSHA AI - Women Safety & Emergency Response Platform"
VERSION=1.0.0
APP_ENV=development # development | production | test
SECRET_KEY=change-this-to-a-cryptographically-secure-random-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 days
DEMO_MODE=true
NATIONAL_EMERGENCY_NUMBER=112

# ----------------- DATABASE CONFIGURATION -----------------
# For Local Development (SQLite):
DATABASE_URL=sqlite:///./suraksha_ai.db
# For Production / Docker (PostgreSQL):
# DATABASE_URL=postgresql://suraksha_user:suraksha_password@localhost:5432/suraksha_db

# ----------------- CORS CONFIGURATION -----------------
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ----------------- SMS NOTIFICATION PROVIDER -----------------
# Options: "mock" (default demo mode), "twilio"
SMS_PROVIDER=mock
# If using Twilio:
SMS_API_KEY=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMS_API_SECRET=your_twilio_auth_token_here
SMS_FROM_NUMBER=+1234567890

# ----------------- EMAIL NOTIFICATION PROVIDER -----------------
# Options: "mock" (default demo mode), "sendgrid", "smtp"
EMAIL_PROVIDER=mock
# If using SendGrid:
EMAIL_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=alerts@suraksha-ai.org

# ----------------- AI ENGINE CONFIGURATION -----------------
# Options: "rule_based" (deterministic explainable engine, zero external cost), "gemini", "openai"
AI_PROVIDER=rule_based
# If using Gemini / OpenAI:
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# ----------------- MAPS & GEOCODING -----------------
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
GEOCODING_PROVIDER=osm_nominatim
GEOCODING_API_KEY=
ROUTING_PROVIDER=osrm
ROUTING_API_KEY=
